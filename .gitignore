# ---------------------------------------------------------------------------
# Data - NEVER commit. This project operates under IRB/DSRB oversight; no
# patient or participant video may ever enter version control.
#
# These ignore the CONTENTS but keep the directory itself tracked via .gitkeep,
# so a fresh clone still has the layout the README's recreate steps assume.
# ---------------------------------------------------------------------------
data/*
!data/.gitkeep
results/*
!results/.gitkeep

# Video / signal artefacts
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.mat
*.npy
*.npz
*.h5
*.hdf5

# Model weights and bundles (re-download via the URL recorded in README.md)
models/*.task
models/*.pth
models/*.pt
models/*.onnx
models/*.tflite
*.ckpt
*.safetensors

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
.conda/

# Notebooks
.ipynb_checkpoints/

# Secrets / config
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
