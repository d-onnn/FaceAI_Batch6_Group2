# ---------------------------------------------------------------------------
# Data - NEVER commit. This project operates under IRB/DSRB oversight; no
# patient or participant video may ever enter version control.
#
# These ignore the CONTENTS but keep the directory itself tracked via .gitkeep,
# so a fresh clone still has the layout the README's recreate steps assume.
# ---------------------------------------------------------------------------
data/*
!data/.gitkeep
results/*
!results/.gitkeep

# Video / signal artefacts
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.mat
*.npy
*.npz
*.h5
*.hdf5

# Model weights and bundles (re-download via the URL recorded in README.md)
models/*.task
models/*.pth
models/*.pt
models/*.onnx
models/*.tflite
*.ckpt
*.safetensors

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
build/
dist/
*.egg-info/
.eggs/

# Environments
# (No bare `env/` rule: env/ holds the committed environment record -
#  lockfile.txt and hardware.json - not a virtualenv.)
.venv/
venv/
.conda/

# Derived artefacts, caches and experiment tracking - regenerable, never committed.
# EXCEPTION: the split assignment is committed. It defines the experiment for the whole
# team and holds no health data - only patient_id, step, camera, split and fold.
artifacts/*
!artifacts/splits.parquet
!artifacts/splits.json
mlruns/
*.db

# Notebooks
.ipynb_checkpoints/

# Secrets / config
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
